{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "html-share",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_ENABLED": "true",
    "AUTH_PASSWORD": "779486149",
    "COOKIE_SECRET": "change-me-before-production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quickshare-db",
      "database_id": "d3a16926-a67f-482f-897e-04fbe2dcafbb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT_BUCKET",
      "bucket_name": "quickshare-content"
    }
  ]
}
